{
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT"
        ]
    },
    "dry_run": true,
    "dry_run_wallet": 10000,
    "initial_state": "running",
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "timeframe": "1h",
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10
    },
    "max_open_trades": 3,
    "tradable_balance_ratio": 0.99,
    "stoploss": -0.05,
    "minimal_roi": {
        "0": 100
    },
    "datadir": "freqtrade_config/data",
    "user_data_dir": "freqtrade_config",
    "strategy_path": "freqtrade_config/strategies/",
    "hyperopt_path": "freqtrade_config/user_data/hyperopts/",
    "db_url": "sqlite:///freqtrade_config/tradesv3_futures_dryrun.sqlite",
    "logfile": "freqtrade_config/logs/freqtrade_futures.log",
    "internals": {
        "process_throttle_secs": 5
    },
    "telegram": {
        "enabled": true,
        "token": "",
        "chat_id": "",
        "notification_settings": {
            "status": "on",
            "entry": "on",
            "exit": "on",
            "entry_fill": "on",
            "exit_fill": "on",
            "protection_trigger": "on",
            "protection_trigger_global": "on"
        }
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    }
